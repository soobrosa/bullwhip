# dlt-ops secrets — credentials for sources and destinations.
#
# Copy to .dlt/secrets.toml and fill in.  Do not commit real secrets.
# These can also be set via environment variables (dlt's standard convention):
#   DESTINATION__DUCKDB__CREDENTIALS=warehouse.duckdb
#   SOURCES__GITHUB_HEALTH__CREDENTIALS__TOKEN=ghp_...
# That is how .github/workflows/nightly.yml supplies them — no file needed.

# DuckDB destination path (shared with SQLMesh).
# Relative to the project root (the makefile runs dlt-ops from there).
[destination.duckdb]
credentials = "warehouse.duckdb"

# GitHub API token for the github_health source.
# Set GITHUB_HEALTH_FIXTURE=1 to use fixture data instead (no token needed).
[sources.github_health.credentials]
token = ""
